# Kasbuka Environment Variables
# Perhatian: Tidak boleh ada secret dengan prefix NEXT_PUBLIC_ (PRD Bagian 10)

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kasbuka"

# Session & Auth Secret
AUTH_SECRET="kasbuka_super_secret_auth_session_key_minimum_32_characters_long"

# Midtrans (Sandbox) - Server Key HANYA dibaca di server
MIDTRANS_SERVER_KEY="SB-Mid-server-placeholder"
MIDTRANS_CLIENT_KEY="SB-Mid-client-placeholder"
MIDTRANS_IS_PRODUCTION="false"

# Cloudflare R2 / Storage Bukti
STORAGE_BUCKET="kasbuka-proofs"
STORAGE_ENDPOINT="https://placeholder.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="placeholder"
STORAGE_SECRET_ACCESS_KEY="placeholder"
