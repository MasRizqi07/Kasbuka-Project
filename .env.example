# Kasbuka Environment Variables
# Perhatian: Tidak boleh ada secret dengan prefix NEXT_PUBLIC_ (PRD Bagian 10)

# Database PostgreSQL (Supabase / Neon / Lokal)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kasbuka"
# Direct URL untuk migrasi fisik (bypass pooler)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kasbuka"

# Database khusus pengujian otomatis (wajib kasbuka_test)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/kasbuka_test"

# Flag Aktivasi Donasi Online (Sesuai Keputusan D1: default "false" di production pilot)
DONATIONS_ENABLED="false"

# Session & Auth Secret (minimum 32 karakter)
AUTH_SECRET="kasbuka_super_secret_auth_session_key_minimum_32_characters_long"

# Midtrans (Sandbox / Production) - Server Key HANYA dibaca di server
MIDTRANS_SERVER_KEY="SB-Mid-server-placeholder"
MIDTRANS_CLIENT_KEY="SB-Mid-client-placeholder"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-placeholder"
MIDTRANS_IS_PRODUCTION="false"

# URL Publik Aplikasi
NEXT_PUBLIC_APP_URL="https://staging.kasbuka.org"

# Penyimpanan Bukti Nota (Supabase Storage di Staging/Production, Local di Dev)
STORAGE_PROVIDER="local"
SUPABASE_URL="https://placeholder.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="placeholder_service_role_secret"
SUPABASE_STORAGE_BUCKET="kasbuka-proofs"
